{
  "Jwt": {
    "Issuer": "SUBank.Api",
    "Audience": "SUBank.Client",
    "SigningKey": "SUBank-Development-Only-Key-Do-Not-Use-In-Production-2026",
    "AccessTokenMinutes": 15,
    "CustomerSessionMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshConcurrencyGraceSeconds": 30
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=SUBankV2;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Cors": {
    "ClientOrigin": "https://localhost:7081"
  },
  "ActiveSession": {
    "RedisConnection": "localhost:6379,abortConnect=false",
    "KeyPrefix": "subank:dev:active-session:"
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": true,
    "SeedDemoData": true,
    "AllowedSeedDataSource": ".",
    "AllowedSeedDatabase": "SUBankV2"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApplicationLogging": {
    "FileEnabled": true,
    "Directory": "logs",
    "FileSizeLimitBytes": 10485760,
    "RetainedFileCountLimit": 31,
    "RetainedDays": 14
  }
}
