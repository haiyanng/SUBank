    {
      "id": "transfer-100",
      "type": "text",
      "x": 80,
      "y": 2355,
      "width": 919.73046875,
      "height": 89.7,
      "angle": 0,
      "strokeColor": "#3c3c3c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.5,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "node-notes"
      ],
      "frameId": null,
      "index": "b0b",
      "roundness": null,
      "seed": 1263271325,
      "version": 2,
      "versionNonce": 1799359517,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789104119629,
      "link": null,
      "locked": false,
      "text": "Idempotency giúp yêu cầu gửi lại không bị trừ tiền hai lần; không phải giao dịch mới.\nNếu SignalR lỗi, giao dịch đã commit vẫn thành công. Client vẫn lấy dữ liệu qua REST.\nLỗi nghiệp vụ được ghi Audit khi có thể; sơ đồ rút gọn không tách riêng từng loại lỗi HTTP.",
      "fontSize": 23,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idempotency giúp yêu cầu gửi lại không bị trừ tiền hai lần; không phải giao dịch mới.\nNếu SignalR lỗi, giao dịch đã commit vẫn thành công. Client vẫn lấy dữ liệu qua REST.\nLỗi nghiệp vụ được ghi Audit khi có thể; sơ đồ rút gọn không tách riêng từng loại lỗi HTTP.",
      "autoResize": true,
      "lineHeight": 1.3
    },
