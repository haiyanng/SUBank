    api -. "Tham chiếu project" .-> contracts
    application -. "Tham chiếu project" .-> domain
    application -. "Tham chiếu project" .-> contracts
    infrastructure -. "Triển khai abstraction" .-> application
    infrastructure -. "Tham chiếu project" .-> domain

    infrastructure -->|"EF Core"| sql
    infrastructure -->|"StackExchange.Redis"| redis
    api -->|"Serilog"| logs

