flowchart LR
    %% Kiến trúc triển khai và quan hệ giữa các project hiện tại
    subgraph clientSide["Phía người dùng"]
        browser["Trình duyệt"]
        client["SUBank.Client<br/>Blazor WebAssembly + Bootstrap"]
    end

    subgraph serverSide["Máy chủ ứng dụng nguyên khối"]
        api["SUBank.Api<br/>ASP.NET Core Web API + SignalR"]
        application["SUBank.Application<br/>Use case và abstraction"]
        infrastructure["SUBank.Infrastructure<br/>Identity, EF Core, phiên, PDF và QR"]
        domain["SUBank.Domain<br/>Entity, enum và quy tắc cốt lõi"]
        contracts["SUBank.Contracts<br/>DTO dùng chung"]
    end

    subgraph dataStores["Hạ tầng dữ liệu"]
        sql[("SQL Server<br/>Dữ liệu nghiệp vụ và Identity")]
        redis[("Redis<br/>Phiên đang hoạt động")]
        logs[("Application log<br/>Tệp JSON luân phiên")]
    end

    browser -->|"Tải ứng dụng"| client
