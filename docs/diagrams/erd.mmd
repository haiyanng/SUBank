erDiagram
    ASP_NET_USERS ||--o| CUSTOMER_PROFILE : "có nếu là Customer"
    ASP_NET_USERS ||--o{ ASP_NET_USER_ROLES : "được gán"
    ASP_NET_ROLES ||--o{ ASP_NET_USER_ROLES : "chứa user"
    ASP_NET_USERS ||--o{ FINANCIAL_TRANSACTION : "tạo"
    ASP_NET_USERS ||--o{ AUDIT_LOG : "thực hiện"
    ASP_NET_USERS ||--o{ REFRESH_TOKEN : "sở hữu"
    CUSTOMER_PROFILE ||--o{ BANK_ACCOUNT : "sở hữu"
    BANK_ACCOUNT ||--o{ FINANCIAL_TRANSACTION : "nguồn"
    BANK_ACCOUNT ||--o{ FINANCIAL_TRANSACTION : "đích"
    REFRESH_TOKEN o|--o| REFRESH_TOKEN : "thay thế"

    CUSTOMER_PROFILE {
        bigint Id PK
        string UserId FK,UK
        string FullName
        date DateOfBirth
        string IdentityNumber UK
        string Phone UK
        string Email UK
        string PermanentAddress
        string TemporaryAddress
    }

    BANK_ACCOUNT {
        bigint Id PK
        bigint CustomerProfileId FK
        string AccountNumber UK
        decimal Balance
        string Currency
        string Status
        rowversion RowVersion
    }

    FINANCIAL_TRANSACTION {
        bigint Id PK
        string ReferenceNo UK
        bigint SourceAccountId FK
        bigint DestinationAccountId FK
        string CreatedByUserId FK
        string Type
        decimal Amount
        string Description
        string IdempotencyKey UK
        string RequestHash
        datetimeoffset CreatedAtUtc
    }

    AUDIT_LOG {
        bigint Id PK
        string UserId FK
        string Action
        string EntityType
        string EntityId
        string Result
        string CorrelationId
        datetimeoffset CreatedAtUtc
    }

    REFRESH_TOKEN {
        bigint Id PK
        string UserId FK
        string SessionId
        string TokenHash UK
        datetimeoffset ExpiresAtUtc
        datetimeoffset RevokedAtUtc
        bigint ReplacedByTokenId FK
    }
