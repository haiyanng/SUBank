@page "/"
@page "/login"
@using System.ComponentModel.DataAnnotations
@layout AuthLayout
@inject ApiSession Session
@inject RealtimeService Realtime
@inject NavigationManager Navigation

<PageTitle>Đăng nhập · SUBank</PageTitle>

<div class="login-page">
    <div class="decor decor-one"></div>
    <div class="decor decor-two"></div>

    <main class="login-container">
        <header class="brand-area">
            <div class="brand-lockup">
                <BrandWordmark />
            </div>
            <p>Simple. Secure. Seamless.</p>
        </header>

        <section class="login-card">
            <div class="card-heading">
                <h1>Đăng nhập để tiếp tục</h1>
                <p>Chào mừng bạn trở lại SUBank</p>
            </div>

            <EditForm Model="model" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="username">Tên đăng nhập</label>
                    <InputText id="username" autocomplete="username" class="form-control" placeholder="Nhập tên đăng nhập" @bind-Value="model.UserName" />
                    <ValidationMessage For="@(() => model.UserName)" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="password">Mật khẩu</label>
                    <div class="password-field">
                        <InputText id="password" type="@(showPassword ? "text" : "password")" autocomplete="current-password" class="form-control" placeholder="Nhập mật khẩu" @bind-Value="model.Password" />
                        <button type="button" aria-label="@(showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu")" @onclick="TogglePassword">@(showPassword ? "Ẩn" : "Hiện")</button>
                    </div>
                    <ValidationMessage For="@(() => model.Password)" />
                </div>

                <div class="text-end mb-3">
                    <button type="button" class="forgot-link" @onclick="ShowForgotPassword">Quên tên đăng nhập / Mật khẩu?</button>
                </div>

                @if (!string.IsNullOrEmpty(info)) { <div class="alert alert-info py-2" role="status">@info</div> }
                @if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger py-2" role="alert">@error</div> }

                <button class="btn btn-gold w-100" disabled="@busy">@(busy ? "Đang xác thực..." : "Đăng nhập")</button>
            </EditForm>
        </section>

        <footer>SUBank V2.4 · Sản phẩm mô phỏng phục vụ học tập</footer>
    </main>
</div>

@code {
    [SupplyParameterFromQuery(Name = "reason")]
    public string? Reason { get; set; }

    private readonly LoginModel model = new();
    private string? error;
    private string? info;
    private bool busy;
    private bool showPassword;

    protected override void OnInitialized()
    {
        if (Session.Current is not null) NavigateAfterLogin();
    }

    protected override void OnParametersSet()
    {
        info = Reason switch
        {
            "session-expired" => "Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.",
            "session-replaced" => "Tài khoản đã đăng nhập ở nơi khác. Phiên này đã kết thúc.",
            "logout-unconfirmed" => "Thiết bị đã khóa phiên cục bộ, nhưng server chưa xác nhận thu hồi. Vui lòng đăng nhập lại để tiếp tục.",
            _ => null
        };
    }

    private void TogglePassword() => showPassword = !showPassword;
    private void ShowForgotPassword() { error = null; info = "Vui lòng liên hệ Admin để xác minh và được hỗ trợ thông tin đăng nhập."; }

    private async Task LoginAsync()
    {
        if (busy) return;

        busy = true;
        error = null;
        info = null;
        try
        {
            await Realtime.PrepareForLoginAsync();
            await Session.LoginAsync(model.UserName, model.Password);
            Realtime.ClearMessage();
            NavigateAfterLogin();
        }
        catch (ApiRequestException exception) { error = exception.Message; }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            error = "Không thể kết nối đến dịch vụ SUBank. Vui lòng kiểm tra kết nối và thử lại.";
        }
        catch (InvalidOperationException exception) { error = exception.Message; }
        catch { error = "Không thể đăng nhập lúc này. Vui lòng thử lại."; }
        finally
        {
            model.Password = string.Empty;
            showPassword = false;
            busy = false;
        }
    }

    private void NavigateAfterLogin() => Navigation.NavigateTo(
        Session.IsInRole("Customer") ? "/accounts" :
        Session.IsInRole("Teller") ? "/staff/deposit" : "/staff/users");

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên đăng nhập.")]
        [StringLength(256, ErrorMessage = "Tên đăng nhập không vượt quá 256 ký tự.")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [StringLength(256, ErrorMessage = "Mật khẩu không vượt quá 256 ký tự.")]
        public string Password { get; set; } = "";
    }
}
