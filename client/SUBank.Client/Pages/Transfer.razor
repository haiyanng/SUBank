@page "/transfer"
@inject ApiSession Session
<PageTitle>Chuyển tiền · SUBank</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Chuyển tiền an toàn</div><h1 class="mb-1">Chuyển tiền nội bộ</h1><p>Kiểm tra kỹ người nhận và số tiền trước khi xác nhận.</p></div><a class="btn btn-outline-secondary" href="qr">Quét QR</a></div>
<div class="row g-4"><div class="col-lg-7"><div class="card"><div class="card-body p-lg-4"><EditForm Model="model" OnValidSubmit="SubmitAsync">
<div class="mb-3"><label class="form-label" for="source">Tài khoản nguồn</label><InputText id="source" readonly class="form-control bg-body-tertiary" @bind-Value="model.Source" /></div>
<div class="mb-3"><label class="form-label" for="destination">Tài khoản nhận</label><InputText id="destination" inputmode="numeric" maxlength="10" class="form-control" @bind-Value="model.Destination" /></div>
<div class="mb-3"><label class="form-label" for="amount">Số tiền (VND)</label><InputNumber id="amount" class="form-control form-control-lg money" @bind-Value="model.Amount" /></div>
<div class="mb-3"><label class="form-label" for="description">Nội dung</label><InputText id="description" maxlength="280" class="form-control" @bind-Value="model.Description" /></div>
<div class="mb-3"><label class="form-label" for="transaction-password">Mật khẩu giao dịch</label><InputText id="transaction-password" type="password" inputmode="numeric" autocomplete="off" class="form-control" @bind-Value="model.TransactionPassword" /></div>
@if (message is not null) { <div class="alert @(success ? "alert-success" : "alert-danger")" role="alert">@message</div> }
<button class="btn btn-primary btn-lg w-100" disabled="@busy">@(busy ? "Đang xử lý..." : "Xác nhận chuyển tiền")</button>
</EditForm></div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-body"><h2 class="h5">Lưu ý trước khi chuyển</h2><ul class="text-body-secondary ps-3"><li class="mb-2">SUBank chỉ mô phỏng chuyển tiền nội bộ.</li><li class="mb-2">Giao dịch thành công sẽ cập nhật số dư realtime.</li><li>Không chia sẻ mật khẩu giao dịch cho người khác.</li></ul><hr /><div class="metric-label">Số tiền đang nhập</div><div class="h2 money">@model.Amount.ToString("N0") VND</div></div></div></div></div>
@code {
    [SupplyParameterFromQuery(Name = "source")] public string? Source { get; set; } [SupplyParameterFromQuery(Name = "destination")] public string? Destination { get; set; } [SupplyParameterFromQuery(Name = "amount")] public decimal? Amount { get; set; } [SupplyParameterFromQuery(Name = "description")] public string? Description { get; set; }
    private readonly FormModel model = new() { Source = "0900000001", Destination = "0900000002", TransactionPassword = "123456" }; private readonly IdempotencyIntentTracker<TransferIntent> idempotencyIntent = new(); private string? message; private bool success; private bool busy;
    protected override async Task OnInitializedAsync() { var accounts = await Session.GetAccountsAsync(); model.Source = accounts?.FirstOrDefault(x => x.AccountNumber == Source)?.AccountNumber ?? accounts?.FirstOrDefault()?.AccountNumber ?? model.Source; }
    protected override void OnParametersSet() { if (!string.IsNullOrWhiteSpace(Destination)) model.Destination = Destination; if (Amount is not null) model.Amount = Amount.Value; if (Description is not null) model.Description = Description; }
    private async Task SubmitAsync() { if (busy) return; busy = true; message = null; try { var request = new TransferRequest(model.Source, model.Destination, model.Amount, model.Description, model.TransactionPassword); var intent = new TransferIntent(model.Source.Trim(), model.Destination.Trim(), model.Amount, model.Description?.Trim() ?? string.Empty); var result = await Session.TransferAsync(request, idempotencyIntent.GetOrCreateKey(intent)); idempotencyIntent.Complete(); success = true; message = $"Chuyển tiền thành công. Mã giao dịch: {result?.ReferenceNo}"; } catch (Exception ex) { success = false; message = ex.Message; } finally { busy = false; } }
    private sealed record TransferIntent(string SourceAccountNumber, string DestinationAccountNumber, decimal Amount, string Description);
    private sealed class FormModel { public string Source { get; set; } = ""; public string Destination { get; set; } = ""; public decimal Amount { get; set; } = 100000; public string? Description { get; set; } = "Demo"; public string TransactionPassword { get; set; } = ""; }
}
