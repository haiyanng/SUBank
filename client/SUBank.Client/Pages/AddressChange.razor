@page "/address-change"
@inject ApiSession Session

<PageTitle>Yêu cầu đổi địa chỉ</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Hồ sơ khách hàng</div><h1 class="mb-1">Yêu cầu đổi địa chỉ</h1><p>Thay đổi chỉ có hiệu lực sau khi Admin phê duyệt.</p></div></div>
@if (message is not null) { <div class="alert alert-success">@message</div> }
@if (error is not null) { <div class="alert alert-danger">@error</div> }
<div class="card shadow-sm mb-4"><div class="card-body">
    <div class="mb-3"><label class="form-label" for="permanent">Địa chỉ thường trú mới</label>
        <textarea id="permanent" class="form-control" maxlength="500" @bind="permanentAddress"></textarea></div>
    <div class="mb-3"><label class="form-label" for="temporary">Địa chỉ tạm trú mới (không bắt buộc)</label>
        <textarea id="temporary" class="form-control" maxlength="500" @bind="temporaryAddress"></textarea></div>
    <button class="btn btn-primary" disabled="@busy" @onclick="SubmitAsync">Gửi yêu cầu</button>
</div></div>
<h2 class="h4">Lịch sử yêu cầu</h2>
@if (items is null) { <div class="loading-state">Đang tải yêu cầu...</div> }
else if (items.Count == 0) { <div class="empty-state">Chưa có yêu cầu đổi địa chỉ.</div> }
else { <div class="table-responsive"><table class="table mobile-stack-table align-middle"><thead><tr><th>Mã</th><th>Địa chỉ thường trú</th><th>Trạng thái</th><th>Thời gian</th><th>Lý do</th></tr></thead><tbody>
@foreach (var item in items) { <tr><td data-label="Mã">@item.RequestNo</td><td data-label="Địa chỉ">@item.PermanentAddress</td><td data-label="Trạng thái">@item.Status</td><td data-label="Thời gian">@item.RequestedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td data-label="Lý do">@item.RejectionReason</td></tr> }
</tbody></table></div> }
@code {
    private string permanentAddress = ""; private string? temporaryAddress;
    private List<AddressChangeRequestSummary>? items; private string? message; private string? error; private bool busy;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task SubmitAsync()
    {
        busy = true; error = null; message = null;
        try { await Session.CreateAddressChangeAsync(new(permanentAddress, temporaryAddress)); permanentAddress = ""; temporaryAddress = null; message = "Đã gửi yêu cầu để Admin xử lý."; await LoadAsync(); }
        catch (Exception exception) { error = exception.Message; }
        finally { busy = false; }
    }
    private async Task LoadAsync() { try { items = await Session.GetAddressChangesAsync() ?? []; } catch (Exception exception) { error = exception.Message; } }
}
