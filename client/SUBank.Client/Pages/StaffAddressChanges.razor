@page "/staff/address-changes"
@inject ApiSession Session

<PageTitle>Duyệt đổi địa chỉ</PageTitle>
<h1>Duyệt đổi địa chỉ</h1>
@if (message is not null) { <div class="alert alert-success">@message</div> }
@if (error is not null) { <div class="alert alert-danger">@error</div> }
@if (items is null) { <p>Đang tải...</p> }
else if (items.Count == 0) { <div class="alert alert-info">Không có yêu cầu chờ xử lý.</div> }
else { <div class="row g-3">@foreach (var item in items) { <div class="col-12"><div class="card shadow-sm"><div class="card-body">
    <div class="d-flex justify-content-between"><strong>@item.CustomerName</strong><span>@item.RequestNo</span></div>
    <p class="mb-1"><span class="text-body-secondary">Thường trú:</span> @item.PermanentAddress</p>
    <p><span class="text-body-secondary">Tạm trú:</span> @(item.TemporaryAddress ?? "Không có")</p>
    <button class="btn btn-success btn-sm me-2" disabled="@busy" @onclick="() => ApproveAsync(item.RequestNo)">Duyệt</button>
    <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => SelectReject(item.RequestNo)">Từ chối</button>
</div></div></div> }</div> }
@if (rejectingRequestNo is not null) { <div class="card border-danger mt-4"><div class="card-body">
    <label class="form-label" for="reason">Lý do từ chối @rejectingRequestNo</label>
    <textarea id="reason" class="form-control mb-3" maxlength="280" @bind="rejectionReason"></textarea>
    <button class="btn btn-danger" disabled="@busy" @onclick="RejectAsync">Xác nhận từ chối</button>
    <button class="btn btn-link" @onclick="CancelReject">Hủy</button>
</div></div> }
@code {
    private List<AddressChangeRequestSummary>? items; private string? rejectingRequestNo; private string rejectionReason = "";
    private string? message; private string? error; private bool busy;
    protected override Task OnInitializedAsync() => LoadAsync();
    private void SelectReject(string requestNo) { rejectingRequestNo = requestNo; rejectionReason = ""; }
    private void CancelReject() { rejectingRequestNo = null; rejectionReason = ""; }
    private Task ApproveAsync(string requestNo) => ExecuteAsync(() => Session.ApproveAddressChangeAsync(requestNo), "Đã duyệt yêu cầu.");
    private async Task RejectAsync() { if (rejectingRequestNo is null) return; await ExecuteAsync(() => Session.RejectAddressChangeAsync(rejectingRequestNo, rejectionReason), "Đã từ chối yêu cầu."); CancelReject(); }
    private async Task ExecuteAsync(Func<Task> action, string success) { busy = true; error = null; message = null; try { await action(); message = success; await LoadAsync(); } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task LoadAsync() { try { items = await Session.GetPendingAddressChangesAsync() ?? []; } catch (Exception exception) { error = exception.Message; } }
}
