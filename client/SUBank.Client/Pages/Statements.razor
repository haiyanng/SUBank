@page "/statements"
@inject ApiSession Session
@inject IJSRuntime JS

<PageTitle>Sao kê tài khoản</PageTitle>
<h1>Sao kê tài khoản</h1>
@if (error is not null) { <div class="alert alert-danger">@error</div> }
<div class="row g-3 align-items-end mb-4">
    <div class="col-12 col-md-4"><label class="form-label" for="account">Số tài khoản</label><input id="account" class="form-control" maxlength="10" @bind="accountNumber" /></div>
    <div class="col-6 col-md-2"><label class="form-label" for="year">Năm</label><input id="year" class="form-control" type="number" min="2000" max="2100" @bind="year" /></div>
    <div class="col-6 col-md-2"><label class="form-label" for="month">Tháng</label><select id="month" class="form-select" @bind="month"><option value="">Cả năm</option>@for (var value = 1; value <= 12; value++) { <option value="@value">@value</option> }</select></div>
    <div class="col-12 col-md-4"><button class="btn btn-primary me-2" disabled="@busy" @onclick="LoadAsync">Xem sao kê</button><button class="btn btn-outline-danger" disabled="@(busy || statement is null)" @onclick="DownloadPdfAsync">Tải PDF</button></div>
</div>
@if (statement is not null)
{
    <div class="row g-3 mb-3"><div class="col-md-3"><div class="card"><div class="card-body">Số dư đầu kỳ<br /><strong>@statement.OpeningBalance.ToString("N2")</strong></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body">Tổng ghi có<br /><strong class="text-success">@statement.TotalCredit.ToString("N2")</strong></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body">Tổng ghi nợ<br /><strong class="text-danger">@statement.TotalDebit.ToString("N2")</strong></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body">Số dư cuối kỳ<br /><strong>@statement.ClosingBalance.ToString("N2")</strong></div></div></div></div>
    <div class="table-responsive"><table class="table"><thead><tr><th>Thời gian</th><th>Mã</th><th>Chiều</th><th class="text-end">Số tiền</th></tr></thead><tbody>
    @foreach (var item in statement.Transactions) { <tr><td>@item.CreatedAtUtc.ToLocalTime()</td><td>@item.ReferenceNo</td><td>@item.Direction</td><td class="text-end">@item.Amount.ToString("N2")</td></tr> }
    </tbody></table></div>
}
@code {
    private string accountNumber = ""; private int year = DateTime.UtcNow.Year; private int? month = DateTime.UtcNow.Month;
    private AccountStatement? statement; private string? error; private bool busy;
    protected override async Task OnInitializedAsync() { var accounts = await Session.GetAccountsAsync(); accountNumber = accounts?.FirstOrDefault()?.AccountNumber ?? ""; }
    private async Task LoadAsync() { busy = true; error = null; try { statement = await Session.GetStatementAsync(accountNumber, year, month); } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
    private async Task DownloadPdfAsync() { busy = true; error = null; try { var bytes = await Session.GetStatementPdfAsync(accountNumber, year, month); var period = month is null ? year.ToString() : $"{year}-{month:00}"; await JS.InvokeVoidAsync("subankDownloadBase64", $"SUBank-{accountNumber}-{period}.pdf", "application/pdf", Convert.ToBase64String(bytes)); } catch (Exception exception) { error = exception.Message; } finally { busy = false; } }
}
