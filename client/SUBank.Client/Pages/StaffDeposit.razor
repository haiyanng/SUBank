@page "/staff/deposit"
@inject ApiSession Session
<PageTitle>Nộp tiền mặt · SUBank</PageTitle>
<div class="page-heading"><div><div class="eyebrow">Khu vực giao dịch viên</div><h1 class="mb-1">Nộp tiền mặt</h1><p>Ghi nhận tiền mặt vào tài khoản khách hàng tại quầy.</p></div></div>
<div class="row"><div class="col-lg-7"><EditForm Model="model" OnValidSubmit="SubmitAsync"><div class="card"><div class="card-body p-lg-4">
    <div class="mb-3"><label class="form-label">Tài khoản nhận</label><InputText class="form-control" @bind-Value="model.Account" /></div>
    <div class="mb-3"><label class="form-label">Số tiền</label><InputNumber class="form-control" @bind-Value="model.Amount" /></div>
    <div class="mb-3"><label class="form-label">Nội dung</label><InputText class="form-control" @bind-Value="model.Description" /></div>
    @if (message is not null) { <div class="alert @(success ? "alert-success" : "alert-danger")">@message</div> }
    <button class="btn btn-primary btn-lg w-100" disabled="@busy">@(busy ? "Đang xử lý..." : "Ghi nhận nộp tiền")</button>
</div></div></EditForm></div></div>
@code {
    private readonly FormModel model = new() { Account = "1000000001", Amount = 500000, Description = "Nộp tiền tại quầy" }; private string? message; private bool success; private bool busy;
    private async Task SubmitAsync() { busy = true; message = null; try { var r = await Session.DepositAsync(new(model.Account, model.Amount, model.Description)); success = true; message = $"Nộp tiền thành công. Mã giao dịch: {r?.ReferenceNo}"; } catch (Exception ex) { success = false; message = ex.Message; } finally { busy = false; } }
    private sealed class FormModel { public string Account { get; set; } = ""; public decimal Amount { get; set; } public string? Description { get; set; } }
}
