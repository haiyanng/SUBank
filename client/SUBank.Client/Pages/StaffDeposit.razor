@page "/staff/deposit"
@using System.ComponentModel.DataAnnotations
@inject ApiSession Session

<PageTitle>Nộp tiền mặt · SUBank</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Khu vực giao dịch viên</div>
        <h1 class="mb-1">Nộp tiền mặt</h1>
        <p>Ghi nhận tiền mặt vào tài khoản khách hàng tại quầy.</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <EditForm Model="model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            <div class="card">
                <div class="card-body p-lg-4">
                    <div class="mb-3">
                        <label class="form-label" for="destination-account">Tài khoản nhận</label>
                        <InputText id="destination-account"
                                   class="form-control"
                                   autocomplete="off"
                                   inputmode="numeric"
                                   maxlength="10"
                                   @bind-Value="model.Account"
                                   @bind-Value:after="ResetAccountResolution"
                                   @onblur="ResolveAccountAsync" />
                        <ValidationMessage For="@(() => model.Account)" />
                        @if (resolvingAccount)
                        {
                            <div class="form-text" role="status">Đang kiểm tra tài khoản...</div>
                        }
                        else if (accountLookupError is not null)
                        {
                            <div class="text-danger mt-1" role="alert">@accountLookupError</div>
                        }
                    </div>

                    @if (IsAccountResolved)
                    {
                        <div class="mb-3">
                            <label class="form-label" for="deposit-recipient-name">Tên khách hàng</label>
                            <input id="deposit-recipient-name" class="form-control"
                                   value="@resolvedAccount!.DisplayName" readonly />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label" for="deposit-amount">Số tiền</label>
                        <InputNumber id="deposit-amount"
                                     class="form-control"
                                     min="1"
                                     max="999999999999999999"
                                     step="1"
                                     ParsingErrorMessage="Vui lòng điền số tiền."
                                     @bind-Value="model.Amount" />
                        <ValidationMessage For="@(() => model.Amount)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="deposit-description">Nội dung</label>
                        <InputText id="deposit-description"
                                   class="form-control"
                                   maxlength="280"
                                   @bind-Value="model.Description" />
                        <ValidationMessage For="@(() => model.Description)" />
                    </div>

                    @if (message is not null)
                    {
                        <div class="alert @(success ? "alert-success" : "alert-danger")" role="alert">@message</div>
                    }

                    <button class="btn btn-primary btn-lg w-100"
                            disabled="@(busy || resolvingAccount || !IsAccountResolved)">
                        @(busy ? "Đang xử lý..." : "Ghi nhận nộp tiền")
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private FormModel model = new();
    private readonly IdempotencyIntentTracker<DepositIntent> idempotencyIntent = new();
    private ResolvedAccount? resolvedAccount;
    private string? accountLookupError;
    private string? message;
    private bool resolvingAccount;
    private bool success;
    private bool busy;
    private long accountLookupVersion;
    private bool IsAccountResolved =>
        resolvedAccount is not null &&
        string.Equals(
            resolvedAccount.AccountNumber,
            (model.Account ?? string.Empty).Trim(),
            StringComparison.Ordinal);

    private async Task SubmitAsync()
    {
        if (busy)
        {
            return;
        }

        if (!IsAccountResolved)
        {
            success = false;
            accountLookupError = "Không tìm thấy tài khoản.";
            return;
        }

        busy = true;
        message = null;

        try
        {
            var accountNumber = (model.Account ?? string.Empty).Trim();
            var description = string.IsNullOrWhiteSpace(model.Description)
                ? null
                : model.Description.Trim();
            var intent = new DepositIntent(accountNumber, model.Amount, description ?? string.Empty);
            var request = new CashDepositRequest(accountNumber, model.Amount, description);
            var response = await Session.DepositAsync(request, idempotencyIntent.GetOrCreateKey(intent));

            idempotencyIntent.Complete();
            model = new FormModel();
            ResetAccountResolution();
            success = true;
            message = $"Nộp tiền thành công. Mã giao dịch: {response?.ReferenceNo}";
        }
        catch (Exception exception)
        {
            // Không hoàn tất intent khi lỗi: lần gửi lại cùng dữ liệu phải dùng lại idempotency key.
            success = false;
            message = ClientErrorMessage.From(exception);
        }
        finally
        {
            busy = false;
        }
    }

    private void ResetAccountResolution()
    {
        Interlocked.Increment(ref accountLookupVersion);
        resolvedAccount = null;
        accountLookupError = null;
        resolvingAccount = false;
    }

    private async Task ResolveAccountAsync()
    {
        var accountNumber = (model.Account ?? string.Empty).Trim();
        var lookupVersion = Interlocked.Increment(ref accountLookupVersion);
        resolvedAccount = null;
        accountLookupError = null;
        resolvingAccount = false;

        if (!IsAccountNumber(accountNumber))
        {
            accountLookupError = "Không tìm thấy tài khoản.";
            return;
        }

        resolvingAccount = true;
        try
        {
            var result = await Session.ResolveAccountAsync(accountNumber);
            if (lookupVersion != accountLookupVersion) return;

            if (result is null)
            {
                accountLookupError = "Không tìm thấy tài khoản.";
                return;
            }

            resolvedAccount = result;
        }
        catch (Exception exception)
        {
            if (lookupVersion == accountLookupVersion)
                accountLookupError = ClientErrorMessage.From(exception);
        }
        finally
        {
            if (lookupVersion == accountLookupVersion)
                resolvingAccount = false;
        }
    }

    private static bool IsAccountNumber(string value) =>
        value.Length == 10 && value.All(char.IsAsciiDigit);

    private sealed record DepositIntent(string AccountNumber, decimal Amount, string Description);

    private sealed class FormModel : IValidatableObject
    {
        [Required(ErrorMessage = "Vui lòng nhập số tài khoản nhận.")]
        public string Account { get; set; } = string.Empty;

        public decimal Amount { get; set; }

        [StringLength(280, ErrorMessage = "Nội dung không được vượt quá 280 ký tự.")]
        public string? Description { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (Amount < 1m || Amount > 999_999_999_999_999_999m)
            {
                yield return new ValidationResult(
                    "Số tiền phải từ 1 đến 999.999.999.999.999.999 VND.",
                    [nameof(Amount)]);
            }
            else if (decimal.Truncate(Amount) != Amount)
            {
                yield return new ValidationResult(
                    "Số tiền phải là số nguyên VND.",
                    [nameof(Amount)]);
            }
        }
    }
}
