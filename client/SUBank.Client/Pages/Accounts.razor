@page "/accounts"
@implements IDisposable
@inject ApiSession Session

<PageTitle>Trang chủ · SUBank</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Tổng quan khách hàng</div>
        <h1 class="mb-1">Xin chào, @DisplayUserName</h1>
        <p>Theo dõi số dư và truy cập nhanh các dịch vụ ngân hàng của bạn.</p>
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">
        @error
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">Thử lại</button>
    </div>
}
else if (accounts is null)
{
    <div class="loading-state">Đang tải tài khoản...</div>
}
else if (accounts.Count == 0)
{
    <div class="empty-state">
        <h2 class="h5">Chưa có tài khoản</h2>
        <p class="text-body-secondary mb-0">Không tìm thấy tài khoản Customer thuộc phiên đăng nhập này.</p>
    </div>
}
else if (SelectedAccount is { } account)
{
    <section class="account-overview" aria-labelledby="account-card-title">
        <h2 id="account-card-title" class="visually-hidden">Tài khoản đang chọn</h2>
        <article class="bank-card">
            <div class="bank-card-header">
                <div>
                    <div class="bank-card-label">@GetAccountLabel(account)</div>
                    <div class="bank-card-number">@FormatAccount(account.AccountNumber)</div>
                </div>

                <span class="bank-card-status">@FormatStatus(account.Status)</span>
            </div>

            <div class="bank-card-footer">
                <div>
                    <div class="bank-card-label">Số dư khả dụng</div>
                    <div class="bank-card-balance money">@account.Balance.ToString("N2") <small>@account.Currency</small></div>
                </div>

                @if (accounts.Count > 1)
                {
                    <div class="account-switcher">
                        <button class="account-switcher-toggle" type="button"
                                title="Chọn tài khoản khác" aria-label="Chọn tài khoản khác"
                                aria-expanded="@accountMenuOpen" @onclick="ToggleAccountMenu">
                            <svg class="chevron @(accountMenuOpen ? "is-open" : null)" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m6 9 6 6 6-6" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        </article>

        @if (accountMenuOpen)
        {
            <div class="account-menu" aria-label="Danh sách tài khoản">
                @foreach (var option in accounts)
                {
                    <button class="account-option @(option.AccountNumber == account.AccountNumber ? "is-selected" : null)"
                            type="button" aria-pressed="@(option.AccountNumber == account.AccountNumber)"
                            @onclick="() => SelectAccount(option.AccountNumber)">
                        <span class="account-option-copy">
                            <strong>@FormatAccount(option.AccountNumber)</strong>
                            <small>@GetAccountLabel(option)</small>
                        </span>
                        <span class="account-option-balance money">@option.Balance.ToString("N2") <small>@option.Currency</small></span>
                    </button>
                }
            </div>
        }
    </section>

    <nav class="quick-actions" aria-label="Thao tác với tài khoản">
        <a class="quick-action" href="@($"transfer?source={Uri.EscapeDataString(account.AccountNumber)}")">
            <span class="quick-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 8h14" /><path d="m15 5 3 3-3 3" /><path d="M20 16H6" /><path d="m9 13-3 3 3 3" /></svg>
            </span>
            <strong>Chuyển tiền</strong>
        </a>
        <a class="quick-action" href="@($"qr?account={Uri.EscapeDataString(account.AccountNumber)}")">
            <span class="quick-action-icon qr-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="5.5" y="5.5" width="2" height="2" fill="currentColor" stroke="none" />
                    <rect x="14" y="3" width="7" height="7" rx="1" /><rect x="16.5" y="5.5" width="2" height="2" fill="currentColor" stroke="none" />
                    <rect x="3" y="14" width="7" height="7" rx="1" /><rect x="5.5" y="16.5" width="2" height="2" fill="currentColor" stroke="none" />
                    <path d="M14 14h3v3h-3zM18 14h3v3h-3zM14 18h3v3h-3zM19 19h2v2h-2z" fill="currentColor" stroke="none" />
                </svg>
            </span>
            <strong>QR</strong>
        </a>
        <a class="quick-action" href="transactions/@account.AccountNumber">
            <span class="quick-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3.25 2" /><path d="M5.5 5.5 3.5 7.5" /></svg>
            </span>
            <strong>Lịch sử giao dịch</strong>
        </a>
        <a class="quick-action" href="@($"statements?account={Uri.EscapeDataString(account.AccountNumber)}")">
            <span class="quick-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M7 3.5h7l4 4V20.5H7z" /><path d="M14 3.5v4h4" /><path d="M10 12h5M10 15.5h5" /></svg>
            </span>
            <strong>Sao kê</strong>
        </a>
        <a class="quick-action" href="profile">
            <span class="quick-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.25" /><path d="M5.5 20c.5-4 2.75-6 6.5-6s6 2 6.5 6" /></svg>
            </span>
            <strong>Thông tin cá nhân</strong>
        </a>
        <a class="quick-action" href="ai-support">
            <span class="quick-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M5 5.5h14v10H9l-4 3z" />
                    <path d="m15.5 4 .55 1.45L17.5 6l-1.45.55L15.5 8l-.55-1.45L13.5 6l1.45-.55z" />
                    <path d="M9 10.5h6M9 13h3.5" />
                </svg>
            </span>
            <strong>AI hỗ trợ</strong>
        </a>
    </nav>
}

@code {
    private List<AccountSummary>? accounts;
    private CustomerProfileDetail? profile;
    private string? selectedAccountNumber;
    private string? error;
    private bool accountMenuOpen;
    private long loadVersion;

    private string DisplayUserName => profile?.FullName ?? "khách hàng";
    private AccountSummary? SelectedAccount => accounts?.FirstOrDefault(x => x.AccountNumber == selectedAccountNumber)
        ?? accounts?.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        Session.BankingDataChanged += OnBankingDataChanged;
        await LoadAsync();
    }

    private void OnBankingDataChanged() => _ = InvokeAsync(LoadAsync);
    private void ToggleAccountMenu() => accountMenuOpen = !accountMenuOpen;

    private void SelectAccount(string accountNumber)
    {
        selectedAccountNumber = accountNumber;
        accountMenuOpen = false;
    }

    private async Task LoadAsync()
    {
        var version = Interlocked.Increment(ref loadVersion);
        try
        {
            var loadedAccounts = await Session.GetAccountsAsync() ?? [];
            var loadedProfile = await Session.GetProfileAsync();
            if (version != loadVersion) return;

            accounts = loadedAccounts;
            profile = loadedProfile;
            if (loadedAccounts.Count > 0 && loadedAccounts.All(x => x.AccountNumber != selectedAccountNumber))
                selectedAccountNumber = loadedAccounts.FirstOrDefault(x => x.IsPrimary)?.AccountNumber
                    ?? loadedAccounts[0].AccountNumber;
            accountMenuOpen = false;
            error = null;
        }
        catch (Exception ex)
        {
            if (version == loadVersion) error = ClientErrorMessage.From(ex);
        }

        if (version == loadVersion) StateHasChanged();
    }

    private static string GetAccountLabel(AccountSummary account) =>
        account.IsPrimary ? "Tài khoản chính" : "Tài khoản phụ";

    private static string FormatAccount(string value) =>
        value.Length == 10 ? $"{value[..4]} {value[4..7]} {value[7..]}" : value;

    private static string FormatStatus(string value) => value switch
    {
        "Active" => "Đang hoạt động",
        "Frozen" => "Tạm khóa",
        "Closed" => "Đã đóng",
        _ => value
    };

    public void Dispose() { Interlocked.Increment(ref loadVersion); Session.BankingDataChanged -= OnBankingDataChanged; }
}
