@page "/transaction/{ReferenceNo}"
@inject ApiSession Session

<PageTitle>Chi tiết giao dịch · SUBank</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Lịch sử giao dịch</div>
        <h1 class="mb-1">Chi tiết giao dịch</h1>
        <p>Thông tin được truy xuất trực tiếp theo mã tham chiếu.</p>
    </div>
    <a class="btn btn-outline-secondary" href="accounts">Quay lại tài khoản</a>
</div>

@if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
else if (item is null) { <div class="loading-state">Đang tải chi tiết giao dịch...</div> }
else
{
    <article class="card detail-card">
        <div class="card-body p-lg-4">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
                <div>
                    <div class="metric-label">Số tiền giao dịch</div>
                    <div class="h2 fw-bold money mb-0">@item.Amount.ToString("N0") VND</div>
                </div>
                <span class="badge rounded-pill text-bg-success align-self-start align-self-sm-center">Hoàn tất</span>
            </div>
            <dl class="detail-list">
                <div><dt>Mã tham chiếu</dt><dd>@item.ReferenceNo</dd></div>
                <div><dt>Loại giao dịch</dt><dd>@item.Type</dd></div>
                <div><dt>Tài khoản nguồn</dt><dd>@(item.SourceAccountNumber ?? "Tiền mặt")</dd></div>
                <div><dt>Tài khoản nhận</dt><dd>@item.DestinationAccountNumber</dd></div>
                <div><dt>Nội dung</dt><dd>@(item.Description ?? "—")</dd></div>
                <div><dt>Thời gian</dt><dd>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</dd></div>
            </dl>
        </div>
    </article>
}

@code {
    [Parameter] public string ReferenceNo { get; set; } = "";
    private SUBank.Contracts.Transactions.TransactionDetail? item;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        try { item = await Session.GetTransactionAsync(ReferenceNo); }
        catch (Exception ex) { error = ex.Message; }
    }
}
