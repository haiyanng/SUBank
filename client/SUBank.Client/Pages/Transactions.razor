@page "/transactions"
@page "/transactions/{AccountNumber}"
@implements IDisposable
@inject ApiSession Session

<PageTitle>Lịch sử giao dịch · SUBank</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Lịch sử giao dịch</div>
        <h1 class="mb-1">Giao dịch gần đây</h1>
        <p>Tìm nhanh và xem chi tiết giao dịch theo từng tài khoản.</p>
    </div>
    <a class="btn btn-primary" href="/accounts">Quay lại trang chủ</a>
</div>

@if (accounts is null && loading)
{
    <div class="loading-state">Đang tải lịch sử giao dịch...</div>
}
else if (error is not null && accounts is null)
{
    <div class="alert alert-danger" role="alert">
        <p class="mb-2">@error</p>
        <button class="btn btn-outline-danger btn-sm" type="button" @onclick="LoadPageAsync">Thử lại</button>
    </div>
}
else if (accounts is { Count: 0 })
{
    <div class="empty-state">Bạn chưa có tài khoản để xem lịch sử giao dịch.</div>
}
else if (accounts is not null)
{
    <section class="history-controls card" aria-label="Tìm kiếm và lọc giao dịch">
        <div class="card-body">
            <div class="history-toolbar">
                <div class="history-account-filter">
                    <label class="form-label" for="history-account">Tài khoản</label>
                    <select id="history-account" class="form-select" value="@selectedAccountNumber"
                            disabled="@loading" @onchange="ChangeAccountAsync">
                        @foreach (var account in accounts)
                        {
                            <option value="@account.AccountNumber">
                                @FormatAccount(account.AccountNumber) · @(account.IsPrimary ? "Tài khoản chính" : "Tài khoản phụ")
                            </option>
                        }
                    </select>
                </div>

                <div class="history-search">
                    <label class="form-label" for="history-search">Tìm kiếm</label>
                    <div class="history-search-box">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                        <input id="history-search" class="form-control" type="search"
                               placeholder="Mã, nội dung hoặc tài khoản"
                               @bind="searchText" @bind:event="oninput" />
                    </div>
                </div>
            </div>

            <div class="history-filter-tabs" role="group" aria-label="Lọc chiều giao dịch">
                <button type="button" class="btn btn-primary @(directionFilter == "all" ? "active" : null)"
                        aria-pressed="@(directionFilter == "all")" @onclick='() => SetDirectionFilter("all")'>Tất cả</button>
                <button type="button" class="btn btn-primary @(directionFilter == "incoming" ? "active" : null)"
                        aria-pressed="@(directionFilter == "incoming")" @onclick='() => SetDirectionFilter("incoming")'>Tiền vào</button>
                <button type="button" class="btn btn-primary @(directionFilter == "outgoing" ? "active" : null)"
                        aria-pressed="@(directionFilter == "outgoing")" @onclick='() => SetDirectionFilter("outgoing")'>Tiền ra</button>
            </div>
        </div>
    </section>

    @if (error is not null)
    {
        <div class="alert alert-danger mt-3" role="alert">
            <p class="mb-2">@error</p>
            <button class="btn btn-outline-danger btn-sm" type="button" disabled="@loading" @onclick="LoadTransactionsAsync">Thử lại</button>
        </div>
    }
    else if (loading || items is null)
    {
        <div class="loading-state">Đang cập nhật giao dịch...</div>
    }
    else if (items.Count == 0)
    {
        <div class="empty-state mt-3">
            <h2 class="h5">Chưa có giao dịch</h2>
            <p class="text-body-secondary mb-0">Tài khoản này chưa phát sinh giao dịch.</p>
        </div>
    }
    else if (FilteredItems.Count == 0)
    {
        <div class="empty-state mt-3">
            <h2 class="h5">Không tìm thấy giao dịch</h2>
            <p class="text-body-secondary mb-0">Hãy đổi từ khóa hoặc bộ lọc nhanh.</p>
        </div>
    }
    else
    {
        <section class="transaction-history" aria-live="polite">
            <div class="transaction-history-heading">
                <h2>Giao dịch gần đây</h2>
                <span>@FilteredItems.Count giao dịch</span>
            </div>

            <div class="transaction-list">
                @foreach (var item in FilteredItems)
                {
                    var outgoing = IsOutgoing(item);
                    <a class="transaction-row" href="@($"/transaction/{Uri.EscapeDataString(item.ReferenceNo)}")"
                       aria-label="Xem chi tiết giao dịch @item.ReferenceNo">
                        <span class="transaction-direction @(outgoing ? "is-outgoing" : "is-incoming")" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M7 17 17 7" /><path d="M9 7h8v8" /></svg>
                        </span>

                        <span class="transaction-copy">
                            <strong>@GetTitle(item, outgoing)</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <span class="transaction-description">@item.Description</span>
                            }
                            <small>@VietnamTime(item.CreatedAtUtc).ToString("dd/MM/yyyy HH:mm") · @item.ReferenceNo</small>
                        </span>

                        <span class="transaction-amount @(outgoing ? "is-outgoing" : "is-incoming")">
                            @(outgoing ? "−" : "+")@item.Amount.ToString("N0") <small>VND</small>
                        </span>

                        <span class="transaction-chevron" aria-hidden="true">›</span>
                    </a>
                }
            </div>
        </section>
    }
}

@code {
    [Parameter]
    public string? AccountNumber { get; set; }

    private List<AccountSummary>? accounts;
    private List<TransactionSummary>? items;
    private string selectedAccountNumber = string.Empty;
    private string searchText = string.Empty;
    private string directionFilter = "all";
    private string? error;
    private bool loading;
    private long loadVersion;

    private IReadOnlyList<TransactionSummary> FilteredItems => (items ?? [])
        .Where(MatchesDirection)
        .Where(MatchesSearch)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        Session.BankingDataChanged += OnBankingDataChanged;
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        var version = Interlocked.Increment(ref loadVersion);
        loading = true;
        error = null;
        items = null;

        try
        {
            var loadedAccounts = await Session.GetAccountsAsync() ?? [];
            if (version != loadVersion) return;

            accounts = loadedAccounts;
            var requestedAccount = (AccountNumber ?? string.Empty).Trim();
            selectedAccountNumber = loadedAccounts.Any(account => account.AccountNumber == requestedAccount)
                ? requestedAccount
                : loadedAccounts.FirstOrDefault(account => account.IsPrimary)?.AccountNumber
                    ?? loadedAccounts.FirstOrDefault()?.AccountNumber
                    ?? string.Empty;

            List<TransactionSummary> loadedItems = string.IsNullOrEmpty(selectedAccountNumber)
                ? []
                : await Session.GetTransactionsAsync(selectedAccountNumber) ?? [];
            if (version == loadVersion) items = loadedItems;
        }
        catch (Exception exception)
        {
            if (version == loadVersion) error = ClientErrorMessage.From(exception);
        }
        finally
        {
            if (version == loadVersion) loading = false;
        }
    }

    private async Task LoadTransactionsAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedAccountNumber)) return;

        var version = Interlocked.Increment(ref loadVersion);
        loading = true;
        error = null;
        try
        {
            var loadedItems = await Session.GetTransactionsAsync(selectedAccountNumber) ?? [];
            if (version == loadVersion) items = loadedItems;
        }
        catch (Exception exception)
        {
            if (version == loadVersion) error = ClientErrorMessage.From(exception);
        }
        finally
        {
            if (version == loadVersion) loading = false;
        }
    }

    private async Task ChangeAccountAsync(ChangeEventArgs eventArgs)
    {
        var value = eventArgs.Value?.ToString();
        if (accounts?.Any(account => account.AccountNumber == value) != true) return;

        selectedAccountNumber = value!;
        searchText = string.Empty;
        directionFilter = "all";
        await LoadTransactionsAsync();
    }

    private void SetDirectionFilter(string value) => directionFilter = value;

    private bool MatchesDirection(TransactionSummary item) => directionFilter switch
    {
        "incoming" => !IsOutgoing(item),
        "outgoing" => IsOutgoing(item),
        _ => true
    };

    private bool MatchesSearch(TransactionSummary item)
    {
        var term = searchText.Trim();
        if (term.Length == 0) return true;

        return Contains(item.ReferenceNo, term) ||
               Contains(item.Type, term) ||
               Contains(item.Description, term) ||
               Contains(item.SourceAccountNumber, term) ||
               Contains(item.DestinationAccountNumber, term);
    }

    private bool IsOutgoing(TransactionSummary item) =>
        string.Equals(item.SourceAccountNumber, selectedAccountNumber, StringComparison.Ordinal);

    private static string GetTitle(TransactionSummary item, bool outgoing) => item.Type switch
    {
        "CashDeposit" => "Nộp tiền mặt",
        "Transfer" when outgoing => $"Chuyển đến {FormatAccount(item.DestinationAccountNumber)}",
        "Transfer" => $"Nhận từ {FormatAccount(item.SourceAccountNumber ?? "SUBank")}",
        _ => item.Type
    };

    private static bool Contains(string? value, string term) =>
        value?.Contains(term, StringComparison.OrdinalIgnoreCase) == true;

    private static string FormatAccount(string value) =>
        value.Length == 10 ? $"{value[..4]} {value[4..7]} {value[7..]}" : value;

    private static DateTimeOffset VietnamTime(DateTimeOffset value) => value.ToOffset(TimeSpan.FromHours(7));

    private void OnBankingDataChanged() => _ = InvokeAsync(LoadTransactionsAsync);

    public void Dispose()
    {
        Interlocked.Increment(ref loadVersion);
        Session.BankingDataChanged -= OnBankingDataChanged;
    }
}
