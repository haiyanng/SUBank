@inject ApiSession Session
@inject NavigationManager Navigation
@implements IDisposable

<div class="navigation-shell">
    <header class="mobile-header">
        <a class="mobile-brand" href="@HomeUrl" @onclick="CloseMenu">
            <BrandWordmark />
        </a>
        <button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="@(!collapseNavMenu)" @onclick="ToggleNavMenu">
            <span></span><span></span><span></span>
        </button>
    </header>

    @if (!collapseNavMenu)
    {
        <button class="menu-backdrop" type="button" aria-label="Đóng menu" @onclick="CloseMenu"></button>
    }

    <aside class="sidebar @SidebarCssClass">
        <div class="sidebar-head">
            <a class="sidebar-brand" href="@HomeUrl" @onclick="CloseMenu">
                <BrandWordmark />
            </a>
            <button class="sidebar-close" type="button" aria-label="Đóng menu" @onclick="CloseMenu">×</button>
        </div>

        <p class="brand-tagline">Simple. Secure. Seamless.</p>
        <div class="sidebar-divider"></div>

        <nav class="sidebar-nav" aria-label="Điều hướng chính">
            @if (Session.IsInRole("Customer"))
            {
                <span class="nav-section-label">Ngân hàng cá nhân</span>
                <NavLink class="sidebar-link" href="accounts" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">⌂</span><span>Trang chủ</span></NavLink>
                <NavLink class="sidebar-link" href="transfer" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">⇄</span><span>Chuyển tiền</span></NavLink>
                <NavLink class="sidebar-link" href="qr" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">⌗</span><span>QR</span></NavLink>
                <NavLink class="sidebar-link" href="transactions" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">◷</span><span>Lịch sử giao dịch</span></NavLink>
                <NavLink class="sidebar-link" href="statements" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">▤</span><span>Sao kê</span></NavLink>
                <NavLink class="sidebar-link" href="ai-support" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">✦</span><span>AI hỗ trợ</span></NavLink>
                <NavLink class="sidebar-link" href="profile" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">◎</span><span>Thông tin cá nhân</span></NavLink>
            }

            @if (Session.IsInRole("Teller"))
            {
                <span class="nav-section-label">Nghiệp vụ quầy</span>
                <NavLink class="sidebar-link" href="staff/deposit" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">＋</span><span>Nộp tiền mặt</span></NavLink>
            }

            @if (Session.IsInRole("Admin"))
            {
                <span class="nav-section-label">Quản trị hệ thống</span>
                <NavLink class="sidebar-link" href="staff/users" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">♙</span><span>Quản lý người dùng</span></NavLink>
                <NavLink class="sidebar-link" href="staff/audit" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">≡</span><span>Nhật ký kiểm toán</span></NavLink>
            }
        </nav>

        <div class="sidebar-footer">
            @if (Session.Current is null)
            {
                <a class="sidebar-login" href="login" @onclick="CloseMenu">Đăng nhập</a>
            }
            else
            {
                @if (Session.IsInRole("Customer"))
                {
                    <button class="user-summary user-summary-button" type="button"
                            aria-expanded="@userMenuOpen" @onclick="ToggleUserMenu">
                        <span class="user-avatar" aria-hidden="true">@UserInitial</span>
                        <span class="user-copy"><small>@RoleDisplay</small><strong>@UserDisplayName</strong></span>
                        <span class="user-chevron" aria-hidden="true">@(userMenuOpen ? "⌃" : "⌄")</span>
                    </button>

                    @if (userMenuOpen)
                    {
                        <div class="user-account-menu">
                            <button type="button" class="user-account-action" @onclick="ShowPasswordPlaceholder">
                                <span>Đổi mật khẩu</span><span aria-hidden="true">›</span>
                            </button>
                            <button type="button" class="user-account-action" @onclick="ShowCloseAccountNotice">
                                <span>Đóng tài khoản</span><span aria-hidden="true">›</span>
                            </button>
                            @if (userActionMessage is not null)
                            {
                                <p class="user-account-notice" role="status">@userActionMessage</p>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="user-summary">
                        <span class="user-avatar" aria-hidden="true">@UserInitial</span>
                        <span class="user-copy"><small>@RoleDisplay</small><strong>@UserDisplayName</strong></span>
                    </div>
                }
                <button class="logout-button" type="button" disabled="@logoutBusy" @onclick="LogoutAsync">
                    @(logoutBusy ? "Đang đăng xuất..." : "Đăng xuất") <span aria-hidden="true">→</span>
                </button>
            }
        </div>
    </aside>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool logoutBusy;
    private bool userMenuOpen;
    private string? customerFullName;
    private string? userActionMessage;
    private long customerNameLoadVersion;
    private string SidebarCssClass => collapseNavMenu ? string.Empty : "is-open";
    private string HomeUrl => Session.IsInRole("Customer")
        ? "accounts"
        : Session.IsInRole("Teller")
            ? "staff/deposit"
            : Session.IsInRole("Admin")
                ? "staff/users"
                : "";
    private string PrimaryRole => Session.Current?.User.Roles.FirstOrDefault() ?? "User";
    private string UserInitial => Session.IsInRole("Customer")
        ? GetInitials(customerFullName)
        : string.IsNullOrWhiteSpace(Session.Current?.User.UserName)
        ? "S"
        : Session.Current.User.UserName[..1].ToUpperInvariant();
    private string UserDisplayName => Session.IsInRole("Customer")
        ? customerFullName ?? MaskPhone(Session.Current?.User.UserName)
        : Session.Current?.User.UserName ?? "SUBank";
    private string RoleDisplay => PrimaryRole switch
    {
        "Customer" => "Khách hàng",
        "Teller" => "Giao dịch viên",
        "Admin" => "Quản trị viên",
        _ => PrimaryRole
    };

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void CloseMenu()
    {
        collapseNavMenu = true;
        userMenuOpen = false;
        userActionMessage = null;
    }

    private void ToggleUserMenu()
    {
        userMenuOpen = !userMenuOpen;
        if (!userMenuOpen) userActionMessage = null;
    }

    private void ShowPasswordPlaceholder() =>
        userActionMessage = "Chức năng đổi mật khẩu sẽ được bổ sung sau.";

    private void ShowCloseAccountNotice() =>
        userActionMessage = "Quý khách vui lòng đến điểm giao dịch gần nhất để đóng tài khoản";

    private static string MaskPhone(string? value) => value is { Length: 10 }
        ? $"{value[..3]}****{value[^3..]}"
        : "Khách hàng SUBank";

    private static string GetInitials(string? fullName)
    {
        var parts = fullName?.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [];
        return parts.Length switch
        {
            0 => string.Empty,
            1 => parts[0][..1].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
        };
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += Refresh;
        await LoadCustomerNameAsync();
    }

    private void Refresh() => _ = InvokeAsync(RefreshUserSummaryAsync);

    private async Task RefreshUserSummaryAsync()
    {
        userMenuOpen = false;
        userActionMessage = null;
        await LoadCustomerNameAsync();
        StateHasChanged();
    }

    private async Task LoadCustomerNameAsync()
    {
        var version = Interlocked.Increment(ref customerNameLoadVersion);
        if (!Session.IsInRole("Customer"))
        {
            customerFullName = null;
            return;
        }

        try
        {
            var profile = await Session.GetProfileAsync();
            if (version == customerNameLoadVersion)
                customerFullName = string.IsNullOrWhiteSpace(profile?.FullName) ? null : profile.FullName;
        }
        catch
        {
            if (version == customerNameLoadVersion) customerFullName = null;
        }
    }

    private async Task LogoutAsync()
    {
        if (logoutBusy) return;

        logoutBusy = true;
        CloseMenu();
        try
        {
            await Session.LogoutAsync();
            Navigation.NavigateTo("/");
        }
        catch (LogoutNotConfirmedException)
        {
            Navigation.NavigateTo("/login?reason=logout-unconfirmed", replace: true);
        }
        catch (ApiRequestException)
        {
            Navigation.NavigateTo("/login?reason=logout-unconfirmed", replace: true);
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            Navigation.NavigateTo("/login?reason=logout-unconfirmed", replace: true);
        }
        catch
        {
            Navigation.NavigateTo("/login?reason=logout-unconfirmed", replace: true);
        }
        finally
        {
            logoutBusy = false;
        }
    }

    public void Dispose()
    {
        Interlocked.Increment(ref customerNameLoadVersion);
        Session.Changed -= Refresh;
    }
}
