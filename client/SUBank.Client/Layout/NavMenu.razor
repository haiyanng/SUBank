@inject ApiSession Session
@inject NavigationManager Navigation
@implements IDisposable

<div class="navigation-shell">
    <header class="mobile-header">
        <a class="mobile-brand" href="@HomeUrl" @onclick="CloseMenu">
            <BrandWordmark />
        </a>
        <button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="@(!collapseNavMenu)" @onclick="ToggleNavMenu">
            <span></span><span></span><span></span>
        </button>
    </header>

    @if (!collapseNavMenu)
    {
        <button class="menu-backdrop" type="button" aria-label="Đóng menu" @onclick="CloseMenu"></button>
    }

    <aside class="sidebar @SidebarCssClass">
        <div class="sidebar-head">
            <a class="sidebar-brand" href="@HomeUrl" @onclick="CloseMenu">
                <BrandWordmark />
            </a>
            <button class="sidebar-close" type="button" aria-label="Đóng menu" @onclick="CloseMenu">×</button>
        </div>

        <p class="brand-tagline">Simple. Secure. Seamless.</p>
        <div class="sidebar-divider"></div>

        <nav class="sidebar-nav" aria-label="Điều hướng chính">
            @if (Session.IsInRole("Customer"))
            {
                <span class="nav-section-label">Ngân hàng cá nhân</span>
                <NavLink class="sidebar-link" href="accounts" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">⌂</span><span>Trang chủ</span></NavLink>
                <NavLink class="sidebar-link" href="transfer" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">⇄</span><span>Chuyển tiền</span></NavLink>
                <NavLink class="sidebar-link" href="qr" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">⌗</span><span>QR</span></NavLink>
                <NavLink class="sidebar-link" href="statements" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">▤</span><span>Sao kê</span></NavLink>
                <NavLink class="sidebar-link" href="profile" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">◎</span><span>Thông tin khách hàng</span></NavLink>
            }

            @if (Session.IsInRole("Teller"))
            {
                <span class="nav-section-label">Nghiệp vụ quầy</span>
                <NavLink class="sidebar-link" href="staff/deposit" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">＋</span><span>Nộp tiền mặt</span></NavLink>
            }

            @if (Session.IsInRole("Admin"))
            {
                <span class="nav-section-label">Quản trị hệ thống</span>
                <NavLink class="sidebar-link" href="staff/users" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">♙</span><span>Người dùng bị khóa</span></NavLink>
                <NavLink class="sidebar-link" href="staff/audit" @onclick="CloseMenu"><span class="nav-icon" aria-hidden="true">≡</span><span>Nhật ký kiểm toán</span></NavLink>
            }
        </nav>

        <div class="sidebar-footer">
            @if (Session.Current is null)
            {
                <a class="sidebar-login" href="login" @onclick="CloseMenu">Đăng nhập</a>
            }
            else
            {
                <div class="user-summary">
                    <span class="user-avatar" aria-hidden="true">@UserInitial</span>
                    <span class="user-copy"><small>@RoleDisplay</small><strong>@UserDisplayName</strong></span>
                </div>
                <button class="logout-button" type="button" @onclick="LogoutAsync">Đăng xuất <span aria-hidden="true">→</span></button>
            }
        </div>
    </aside>
</div>

@code {
    private bool collapseNavMenu = true;
    private string SidebarCssClass => collapseNavMenu ? string.Empty : "is-open";
    private string HomeUrl => Session.IsInRole("Customer")
        ? "accounts"
        : Session.IsInRole("Teller")
            ? "staff/deposit"
            : Session.IsInRole("Admin")
                ? "staff/users"
                : "";
    private string PrimaryRole => Session.Current?.User.Roles.FirstOrDefault() ?? "User";
    private string UserInitial => Session.IsInRole("Customer")
        ? "KH"
        : string.IsNullOrWhiteSpace(Session.Current?.User.UserName)
        ? "S"
        : Session.Current.User.UserName[..1].ToUpperInvariant();
    private string UserDisplayName => Session.IsInRole("Customer")
        ? MaskPhone(Session.Current?.User.UserName)
        : Session.Current?.User.UserName ?? "SUBank";
    private string RoleDisplay => PrimaryRole switch
    {
        "Customer" => "Khách hàng",
        "Teller" => "Giao dịch viên",
        "Admin" => "Quản trị viên",
        _ => PrimaryRole
    };

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void CloseMenu() => collapseNavMenu = true;

    private static string MaskPhone(string? value) => value is { Length: 10 }
        ? $"{value[..3]}****{value[^3..]}"
        : "Khách hàng SUBank";

    protected override void OnInitialized() => Session.Changed += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        CloseMenu();
        await Session.LogoutAsync();
        Navigation.NavigateTo("/");
    }

    public void Dispose() => Session.Changed -= Refresh;
}
